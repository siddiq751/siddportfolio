# ---------------------------------------------------------------------------
# Contact form delivery — set ONE (see README → "Contact form").
# Without either, the form opens the visitor's email app with the message
# pre-filled, addressed to the email in src/content/site.json.
# ---------------------------------------------------------------------------
PUBLIC_WEB3FORMS_ACCESS_KEY=
PUBLIC_FORMSPREE_ID=

# ---------------------------------------------------------------------------
# AI portfolio assistant (optional, off by default — see README → "Assistant").
# PUBLIC_ASK_ENABLED shows the "Ask" button; the API also needs ASK_ENABLED and a key.
# ---------------------------------------------------------------------------
PUBLIC_ASK_ENABLED=false
ASK_ENABLED=false
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5-5. claude-haiku-5-5 is far cheaper.
ASK_MODEL=

# Absolute site URL for canonical/Open Graph/sitemap (no trailing slash).
# Detected automatically on Vercel.
SITE_URL=
