# Contact form delivery — configure ONE provider (see README → "Contact form").
# Without either value the form still works: it opens the visitor's email app
# with their message pre-filled, addressed to siddiqmd751@gmail.com.

# Web3Forms (https://web3forms.com) — free access key, sent to your email.
VITE_WEB3FORMS_ACCESS_KEY=

# Formspree (https://formspree.io) — the form ID from https://formspree.io/f/<id>
VITE_FORMSPREE_ID=

# Optional: absolute site URL for canonical/Open Graph tags (no trailing slash).
# On Vercel this is detected automatically.
SITE_URL=
