---
// Icon sprite: 1.5px stroke, geometry derived from the sphere + horizon motif. Also holds the mark's gradients.
---

<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="mark-chrome" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ffffff"></stop>
      <stop offset="0.3" stop-color="#d9d9d9"></stop>
      <stop offset="0.47" stop-color="#9a9a9a"></stop>
      <stop offset="0.5" stop-color="#232323"></stop>
      <stop offset="0.57" stop-color="#5c5c5c"></stop>
      <stop offset="0.8" stop-color="#d4d4d4"></stop>
      <stop offset="1" stop-color="#f4f4f4"></stop>
    </linearGradient>
    <radialGradient id="mark-spec" cx="35%" cy="27%" r="40%">
      <stop offset="0" stop-color="#ffffff" stop-opacity="0.95"></stop>
      <stop offset="0.35" stop-color="#ffffff" stop-opacity="0.35"></stop>
      <stop offset="1" stop-color="#ffffff" stop-opacity="0"></stop>
    </radialGradient>
    <radialGradient id="mark-shade" cx="50%" cy="50%" r="50%">
      <stop offset="0" stop-color="#111111" stop-opacity="0.35"></stop>
      <stop offset="1" stop-color="#111111" stop-opacity="0"></stop>
    </radialGradient>
  </defs>
  <symbol id="i-arrow" viewBox="0 0 16 16">
    <path d="M2.5 8h11M9 3.5 13.5 8 9 12.5" fill="none" stroke="currentColor" stroke-width="1.5"></path>
  </symbol>
  <symbol id="i-ne" viewBox="0 0 16 16">
    <path d="M4.5 11.5l7-7M5.5 4.5h6v6" fill="none" stroke="currentColor" stroke-width="1.5"></path>
  </symbol>
  <symbol id="i-up" viewBox="0 0 16 16">
    <path d="M8 13.5v-11M3.5 7 8 2.5 12.5 7" fill="none" stroke="currentColor" stroke-width="1.5"></path>
  </symbol>
  <symbol id="i-close" viewBox="0 0 16 16">
    <path d="m3.5 3.5 9 9m0-9-9 9" fill="none" stroke="currentColor" stroke-width="1.5"></path>
  </symbol>
  <symbol id="i-search" viewBox="0 0 20 20">
    <circle cx="9" cy="9" r="5.5" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
    <path d="M13 13l4 4" fill="none" stroke="currentColor" stroke-width="1.5"></path>
  </symbol>
  <symbol id="i-mail" viewBox="0 0 20 20">
    <path d="M3 5h14v10H3z" fill="none" stroke="currentColor" stroke-width="1.5"></path>
    <path d="m3.5 5.5 6.5 5 6.5-5" fill="none" stroke="currentColor" stroke-width="1.5"></path>
  </symbol>
  <symbol id="i-chat" viewBox="0 0 20 20">
    <path
      d="M10 3.5c3.9 0 7 2.6 7 5.9s-3.1 5.9-7 5.9c-.8 0-1.6-.1-2.3-.3L4 16.5l1-2.9C3.8 12.5 3 11 3 9.4 3 6.1 6.1 3.5 10 3.5Z"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
    ></path>
  </symbol>
  <symbol id="i-copy" viewBox="0 0 20 20">
    <path d="M7 7h9v9H7z M4 13V4h9" fill="none" stroke="currentColor" stroke-width="1.5"></path>
  </symbol>
  <symbol id="i-ask" viewBox="0 0 20 20">
    <circle cx="10" cy="9" r="5.5" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
    <path d="M3 16.5h14" stroke="currentColor" stroke-width="1.5"></path>
    <circle cx="10" cy="9" r="1.4" fill="currentColor"></circle>
  </symbol>
</svg>
