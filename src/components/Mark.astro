---
// The Eclipse: a black disc rising from a line of light. Logo, favicon and loader.
// Gradients live once in Icons.astro (#mark-corona, #mark-disc, #mark-clip).
const { class: className = 'mark', title } = Astro.props;
---

<svg class={className} viewBox="0 0 48 48" role={title ? 'img' : undefined} aria-hidden={title ? undefined : 'true'}>
  {title && <title>{title}</title>}
  <circle cx="24" cy="24" r="17" fill="url(#mark-corona)" clip-path="url(#mark-clip)"></circle>
  <circle cx="24" cy="24" r="11" fill="url(#mark-disc)" clip-path="url(#mark-clip)"></circle>
  <rect x="3" y="31" width="42" height="1.6" fill="#ff8a3d"></rect>
</svg>
