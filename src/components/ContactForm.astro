---
import site from '../content/site.json';
import Mark from './Mark.astro';
---

<div class="panel" data-form-card>
  <form class="form" id="contact-form" novalidate data-contact-form data-email={site.contact.email}>
    <div>
      <h3 class="label">Start a project</h3>
      <p class="form__note">
        Fields marked <span aria-hidden="true">*</span>
        <span class="visually-hidden">with an asterisk</span> are required.
      </p>
    </div>

    <div class="form__row">
      <div class="field">
        <label class="field__label" for="f-name">
          Name <span aria-hidden="true">*</span>
        </label>
        <input
          class="field__input"
          id="f-name"
          name="name"
          type="text"
          autocomplete="name"
          required
          minlength="2"
          maxlength="80"
          aria-describedby="f-name-error"
        />
        <p class="field__error" id="f-name-error"></p>
      </div>
      <div class="field">
        <label class="field__label" for="f-email">
          Email <span aria-hidden="true">*</span>
        </label>
        <input
          class="field__input"
          id="f-email"
          name="email"
          type="email"
          autocomplete="email"
          inputmode="email"
          required
          maxlength="120"
          aria-describedby="f-email-error"
        />
        <p class="field__error" id="f-email-error"></p>
      </div>
    </div>

    <div class="form__row">
      <div class="field">
        <label class="field__label" for="f-type">
          Project type <span aria-hidden="true">*</span>
        </label>
        <div class="field__select">
          <select class="field__input" id="f-type" name="project_type" required aria-describedby="f-type-error">
            <option value="">Select a project type</option>
            {site.services.map((s) => (
              <option>{s.type}</option>
            ))}
            <option>Something else</option>
          </select>
        </div>
        <p class="field__error" id="f-type-error"></p>
      </div>
      <div class="field">
        <label class="field__label" for="f-budget">
          Budget <span class="field__optional">(optional)</span>
        </label>
        <input
          class="field__input"
          id="f-budget"
          name="budget"
          type="text"
          maxlength="60"
          placeholder="Your estimated budget"
        />
      </div>
    </div>

    <div class="field">
      <label class="field__label" for="f-message">
        Message <span aria-hidden="true">*</span>
      </label>
      <textarea
        class="field__input field__textarea"
        id="f-message"
        name="message"
        rows="5"
        required
        minlength="10"
        maxlength="2000"
        aria-describedby="f-message-error f-message-count"
      ></textarea>
      <div class="field__meta">
        <p class="field__error" id="f-message-error"></p>
        <span class="field__count" id="f-message-count" data-count>
          0 / 2000
        </span>
      </div>
    </div>

    <div class="hp" aria-hidden="true">
      <label for="f-company">Company</label>
      <input id="f-company" name="company" type="text" tabindex="-1" autocomplete="off" />
    </div>

    <div class="form__alert" role="alert" data-form-alert hidden></div>

    <div class="form__footer">
      <p class="form__note" data-form-note>
        Your message goes straight to my inbox.
      </p>
      <button class="btn btn--primary" type="submit" data-form-submit>
        <span class="btn__spinner" aria-hidden="true"></span>
        <span data-submit-label>Send message</span>
        <svg class="i i--arrow" aria-hidden="true">
          <use href="#i-arrow"></use>
        </svg>
      </button>
    </div>
  </form>

  <div class="form-success" data-form-success role="status" hidden tabindex="-1" aria-labelledby="form-success-title">
    <Mark class="form-success__mark" />
    <h3 id="form-success-title" data-success-title>
      Message sent.
    </h3>
    <p data-success-text>Thank you for reaching out — I'll get back to you soon.</p>
    <button class="btn btn--secondary" type="button" data-form-reset>
      Send another message
    </button>
  </div>
</div>
